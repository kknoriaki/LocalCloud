<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Makaretu.Dns</id>
    <version>2.0.1</version>
    <title>DNS Object Model</title>
    <authors>Richard Schneider</authors>
    <owners>Richard Schneider</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/richardschneider/net-dns</projectUrl>
    <description>DNS data model with serializer/deserializer for the wire and master file format.</description>
    <releaseNotes>https://github.com/richardschneider/net-dns/releases</releaseNotes>
    <copyright>© 2018-2019 Richard Schneider</copyright>
    <tags>dns</tags>
    <repository type="git" url="https://github.com/richardschneider/net-dns.git" commit="701463d2091e6d98d4cc4490abb0e0ead8ae2985" />
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="SimpleBase" version="1.3.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="SimpleBase" version="1.3.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard1.4">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="SimpleBase" version="1.3.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SimpleBase" version="1.3.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>